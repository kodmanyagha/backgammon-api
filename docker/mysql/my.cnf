[client]
port            = 3306
socket          = /home/DOCKER_USER/mysql_data/data/mysqld.sock
default-character-set=utf8


[mysqld_safe]
socket          = /home/DOCKER_USER/mysql_data/data/mysqld.sock
nice            = 0
default-character-set=utf8


[mysqld]
user                          = DOCKER_USER
pid-file                      = /home/DOCKER_USER/mysql_data/data/mysqld.pid
socket                        = /home/DOCKER_USER/mysql_data/data/mysqld.sock
port                          = 3306
basedir                       = /opt/mysql
datadir                       = /home/DOCKER_USER/mysql_data/data
tmpdir                        = /home/DOCKER_USER/mysql_data/tmp
lc-messages-dir               = /opt/mysql/share
character-set-server          = UTF8MB4
transaction-isolation         = READ-COMMITTED
default-storage-engine        = InnoDB
innodb_numa_interleave        = OFF
mysql_native_password         = ON
plugin-load-add               = auth_socket.so
secure-file-priv              = ""
sql_mode                      = STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION

bind-address                  = 127.0.0.1
max_connections               = 1000

skip-external-locking

default_storage_engine        = InnoDB
innodb_file_per_table         = ON

innodb_buffer_pool_size       = 6G
innodb_buffer_pool_instances  = 8

innodb_redo_log_capacity      = 8G
innodb_log_buffer_size        = 512M

innodb_flush_log_at_trx_commit = 2
sync_binlog                    = 0

innodb_flush_method           = O_DIRECT
innodb_io_capacity            = 8000
innodb_io_capacity_max        = 16000
innodb_read_io_threads        = 8
innodb_write_io_threads       = 8

innodb_autoinc_lock_mode      = 2

skip-log-bin
