RUST_LOG=info
RUST_BACKTRACE=1

#DATABASE_URL="mysql://username:password@127.0.0.1:3306/dbname"
DATABASE_URL="mysql://username:password@localhost/dbname?socket=/home/user/app/docker/volumes/mysql/mysqld.sock";

REDIS_URL="redis+unix:///path/to/redis.sock?db=0&pass=pass&user=user&protocol=resp3"
# REDIS_URL="unix:///path/to/redis.sock?db=0&pass=pass&user=user&protocol=resp3"
# REDIS_URL="redis://user:pass@127.0.0.1:3306/0?protocol=resp3"

HTTP_ALLOW_ORIGIN="http://127.0.0.1:3000"

HTTP_SERVER_IP="127.0.0.1"
HTTP_SERVER_PORT="8082"
HTTP_SERVER_SOCKET="./server.sock"

APP_SECRET="32char32char32char32char32char32"
DEFAULT_REQUESTS_PER_SECOND=50

# 65535   = 64KB
# 1048576 = 1MB
# 2097152 = 2MB
# 4194304 = 4MB
MAX_REQUEST_BODY_BYTES=1048576

CLIENT_IP_SOURCE=CfConnectingIp
AUTH_REQUESTS_PER_MINUTE_PER_IP=30
PUBLIC_REQUESTS_PER_MINUTE_PER_IP=60

GUEST_CREATIONS_PER_HOUR_PER_IP=20
GUEST_CREATIONS_PER_HOUR_GLOBAL=200

CAPTCHA_CHALLENGE_TTL_SECONDS=60
CAPTCHA_VERIFICATION_TTL_SECONDS=604800
CAPTCHA_STARTS_PER_MINUTE_PER_IP=20
CAPTCHA_VERIFICATIONS_PER_MINUTE_PER_IP=30

DOCKER_UID=1000
DOCKER_GID=1000
DOCKER_USER=username
DOCKER_GROUP=username
DB_DATABASE=app
DB_USERNAME=username
DB_PASSWORD=password

FORWARD_APP_SERVER_PORT=8082
FORWARD_MYSQL_PORT=3322
FORWARD_REDIS_PORT=6395
